{
  "compilerOptions": {
    // target es2022 dibutuhkan agar `await` tingkat atas di tests/*.test.ts
    // lolos `tsc --noEmit`. Tidak memengaruhi bundle: Next memakai SWC, dan
    // konfigurasi ini noEmit dengan `lib` yang sudah ditetapkan eksplisit.
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
